# =====================================================================
#  TIKPEMA — environment variables
#  TWO PLANES, TWO TRUST LEVELS. Read the comments before filling in.
# =====================================================================

# ---------------------------------------------------------------------
#  CLIENT PLANE (human users)  —  SAFE to expose in the browser.
#  VITE_ vars are bundled into the frontend. Only put browser-safe,
#  domain-restricted client keys here. NEVER an API key or secret.
# ---------------------------------------------------------------------
VITE_CLIENT_KEY=TEST_CLIENT_KEY:your_modular_wallets_client_key
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# ---------------------------------------------------------------------
#  AGENT PLANE (server-side only)  —  SECRET. Never prefixed VITE_.
#  These are readable ONLY inside netlify/functions. If any of these
#  ever ships to the browser, your agent's funds are compromised.
# ---------------------------------------------------------------------
CIRCLE_API_KEY=TEST_API_KEY:your_circle_standard_api_key
CIRCLE_ENTITY_SECRET=your_registered_entity_secret_hex
ANTHROPIC_API_KEY=sk-ant-your_key
AGENT_MODEL=claude-haiku-4-5-20251001

# Persist these AFTER the first /api/agent-init call (it prints them).
# Re-running agent-init creates NEW wallets — set these to reuse one agent.
AGENT_WALLET_ID=
AGENT_WALLET_ADDRESS=
# Browser-exposed copy of AGENT_WALLET_ADDRESS (VITE_* is bundled into the
# client). Used by useModularWallet.createJobAsUser as provider + evaluator.
VITE_AGENT_WALLET_ADDRESS=
AGENT_ID=

# Optional spend guard: max USDC the agent may move in a single action.
AGENT_MAX_SPEND_USDC=1

# Hard per-transaction cap on agent SENDS/TRANSFERS (user-directed + autonomous),
# separate from AGENT_MAX_SPEND_USDC. Conservative default (5) if unset. Cumulative
# sends are ALSO bounded by the _budget.mjs day-ceiling (PERIOD_CEILING_USDC).
AGENT_SEND_CAP_USDC=5

# Hard per-BRIDGE cap (cross-chain is the highest-stakes action — funds leave Arc).
# Separate from the send cap. Conservative default (25) if unset. Cumulative bridges
# ALSO count against the day-ceiling (PERIOD_CEILING_USDC) like all agent spend.
AGENT_BRIDGE_CAP_USDC=25

# Rolling-UTC-day ceiling on total agent spend PER USER (sends + swaps + bridges +
# research buys). Defaults to 2.0 (tuned for tiny data buys) — RAISE it if you want
# the agent to bridge meaningful amounts, since a bridge's full face value counts.
PERIOD_CEILING_USDC=60

# Autonomous research data-buy: request body for RPC-proxy / request-bound data sellers
# (e.g. QuickNode) whose PAID request must carry the call being paid for. Set to the JSON
# request body; it's forwarded on BOTH the x402 challenge fetch and the settle. Unset/blank
# → no body (the in-repo x402-quote stand-in serves a fixed dataset and needs none).
DATA_SELLER_BODY=

# ---------------------------------------------------------------------
#  VANILLA x402 (EIP-3009 direct on-chain settlement) — Arc Testnet.
#  Buyer: the delegate EOA signs an EIP-3009 authorization against the
#  USDC token (ecrecover requires from == signer, so it MUST be an EOA
#  that holds the USDC). Seller: settles receiveWithAuthorization from
#  its OWN wallet, so the settling wallet == payTo (msg.sender == to).
# ---------------------------------------------------------------------
# Buyer EOA that signs the EIP-3009 auth (Circle dev-controlled EOA).
DELEGATE_ADDRESS=
DELEGATE_WALLET_ID=
# Seller wallet that receives payment AND submits the settle tx. Its
# address is advertised as payTo; msg.sender must equal it, so the
# address and wallet id are the same wallet.
VANILLA_SELLER_ADDRESS=
VANILLA_SELLER_WALLET_ID=

# Session auth (Brick 1). REQUIRED. HMAC secret for signing session tokens.
# Generate a random 32-byte hex string and set it here and in Netlify env.
# Must be >=16 chars. If unset, every money-moving endpoint fails closed (401).
SESSION_SECRET=
