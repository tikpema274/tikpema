# =====================================================================
#  TIKPEMA — environment variables
#  TWO PLANES, TWO TRUST LEVELS. Read the comments before filling in.
# =====================================================================

# ---------------------------------------------------------------------
#  CLIENT PLANE (human users)  —  SAFE to expose in the browser.
#  VITE_ vars are bundled into the frontend. Only put browser-safe,
#  domain-restricted client keys here. NEVER an API key or secret.
# ---------------------------------------------------------------------
VITE_CLIENT_KEY=TEST_CLIENT_KEY:your_modular_wallets_client_key
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# ---------------------------------------------------------------------
#  AGENT PLANE (server-side only)  —  SECRET. Never prefixed VITE_.
#  These are readable ONLY inside netlify/functions. If any of these
#  ever ships to the browser, your agent's funds are compromised.
# ---------------------------------------------------------------------
CIRCLE_API_KEY=TEST_API_KEY:your_circle_standard_api_key
CIRCLE_ENTITY_SECRET=your_registered_entity_secret_hex
ANTHROPIC_API_KEY=sk-ant-your_key
AGENT_MODEL=claude-haiku-4-5-20251001

# Persist these AFTER the first /api/agent-init call (it prints them).
# Re-running agent-init creates NEW wallets — set these to reuse one agent.
AGENT_WALLET_ID=
AGENT_WALLET_ADDRESS=
# Browser-exposed copy of AGENT_WALLET_ADDRESS (VITE_* is bundled into the
# client). Used by useModularWallet.createJobAsUser as provider + evaluator.
VITE_AGENT_WALLET_ADDRESS=
AGENT_ID=

# Optional spend guard: max USDC the agent may move in a single action.
AGENT_MAX_SPEND_USDC=1
